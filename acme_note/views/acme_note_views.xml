<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="acme_note_view_list" model="ir.ui.view">
        <field name="name">acme.note.list</field>
        <field name="model">acme.note</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue" decoration-muted="done">
                <field name="name"/>
                <field name="date_deadline"/>
                <field name="done"/>
                <field name="is_overdue" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="acme_note_view_form" model="ir.ui.view">
        <field name="name">acme.note.form</field>
        <field name="model">acme.note</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Hecha" class="btn-primary"
                            invisible="done"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_deadline"/>
                        <field name="done"/>
                        <field name="is_overdue"/>
                    </group>
                    <field name="description" placeholder="Detalle de la nota"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="acme_note_action" model="ir.actions.act_window">
        <field name="name">Notas Acme</field>
        <field name="res_model">acme.note</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="acme_note_menu"
              name="Notas Acme"
              parent="base.menu_custom"
              action="acme_note_action"
              sequence="100"/>

</odoo>
